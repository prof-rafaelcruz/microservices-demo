PRODUCTS_SERVICE_PORT=3002

# Supabase pooler URL for application queries (Transaction mode).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase direct connection URL for Prisma migrations.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"